OPENAI_API_KEY=
LLM_MODEL=gpt-4.1

# Tracing
TRACING_API_KEY=
TRACING_DISABLED=false
TRACE_INCLUDE_SENSITIVE_DATA=false
WORKFLOW_NAME=Work Order Orchestrator
TRACE_GROUP_ID=

# Sessions
SESSION_ID=
SESSION_DB_PATH=sessions.db

# MCP (local)
MCP_URL=http://localhost:8000/mcp
MCP_TIMEOUT_SECONDS=30
MCP_TOKEN=

# MCP stub server bind address (used by `python -m src.mcp_stub_server`)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# MCP (hosted)
USE_HOSTED_MCP=false
MCP_HOSTED_URL=
MCP_HOSTED_LABEL=capabilities
MCP_REQUIRE_APPROVAL=always

# Prefect
PREFECT_API_URL=http://127.0.0.1:4200/api

# Flow behavior
AUTO_APPROVE=1

# LLM resilience (retry/backoff, optional fallback model)
LLM_FALLBACK_MODEL=
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0
MAX_CONCURRENT_STEPS=0

# Usage metrics & budget (unset limits = disabled)
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=
MAX_COST_USD=
MAX_TOKENS_BUDGET=

# Step checkpointing (resume completed steps across re-runs)
CHECKPOINT_CLEAR_ON_SUCCESS=true
CHECKPOINT_DIR=.checkpoints
CHECKPOINT_ENABLED=false
WORK_ORDER_ID=

# Serve deployment (src/serve.py)
SERVE_CRON=
SERVE_DEPLOYMENT_NAME=work-order-orchestrator
